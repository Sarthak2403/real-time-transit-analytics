[Unit]
Description=Archive closed transit telemetry hours to S3
After=network-online.target transit.service
Wants=network-online.target
Requires=transit.service

[Service]
Type=oneshot
User=transit-export
WorkingDirectory=/opt/transit
EnvironmentFile=/opt/transit/.env
Environment=EXPORT_STATE_DIR=/var/lib/transit-export
ExecStart=/opt/transit/aws/.venv/bin/python /opt/transit/aws/export_telemetry.py
StateDirectory=transit-export
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=2h
